
---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag.astro";
import { projects, type Project } from "../../data/projects";

export const getStaticPaths = (() => {
  return projects.map((project, index) => ({
    params: {
      slug: project.slug,
    },
    props: {
      project,
      index,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

const {
  slug,
  name,
  year,
  category,
  description,
  tags,
  detail,
  seo,
} = project;

const siteUrl = "https://portfolio.ortheyus.uk";
const pageUrl = `${siteUrl}/work/${slug}`;

const title = seo?.title ?? `${name} | David Whalley — Ortheyus`;

const pageDescription = seo?.description ?? description;

const image =
  seo?.image ??
  "/og/og-work.png";

const imageUrl = new URL(image, siteUrl).toString();

const next = projects[index + 1] ?? null;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description: pageDescription,
      inLanguage: "en-GB",
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: imageUrl,
      },
      mainEntity: {
        "@id": `${pageUrl}#project`,
      },
    },
    {
      "@type": "CreativeWork",
      "@id": `${pageUrl}#project`,
      name,
      description: pageDescription,
      url: pageUrl,
      image: imageUrl,
      dateCreated: year,
      genre: "Software Development",
      keywords: tags.join(", "),
      creator: {
        "@type": "Person",
        "@id": `${siteUrl}/#person`,
        name: "David Whalley",
      },
      ...(detail?.github && {
        codeRepository: detail.github,
      }),
      ...(detail?.live && {
        sameAs: [detail.live],
      }),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={pageDescription}
  image={imageUrl}
  schema={schema}
>
  <!-- Project heading -->
  <section class="mx-auto max-w-6xl px-6 pt-10 pb-12">
    <a
      href="/work"
      class="inline-flex items-center gap-2 font-mono text-xl text-primary hover:text-foreground transition-colors"
    >
      <span aria-hidden="true">←</span>
      ALL WORK
    </a>

    <p class="mt-8 font-mono text-2xl text-primary">
      // PROJECT {String(index + 1).padStart(2, "0")}
      · {year}
      · {category.toUpperCase()}
    </p>

    <h1
      class="mt-4 max-w-4xl font-display text-4xl md:text-6xl leading-tight text-primary wrap-break-words"
    >
      {name}
    </h1>

    <p class="mt-6 max-w-3xl text-xl leading-8">
      {description}
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <Tag>{tag}</Tag>
      ))}
    </div>

    <!-- External links -->
    {(detail?.github || detail?.live) && (
      <div class="mt-8 flex flex-wrap gap-4">
        {detail.github && (
          <a
            href={detail.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border-2 border-primary px-6 py-3 font-mono text-xl text-primary hover:bg-primary hover:text-primary-foreground transition-colors"
          >
            <span aria-hidden="true">⌘</span>
            SOURCE CODE
          </a>
        )}

        {detail.live && (
          <a
            href={detail.live}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-primary px-6 py-3 font-mono text-xl text-primary-foreground shadow-[6px_6px_0_var(--secondary)] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition"
          >
            <span aria-hidden="true">↗</span>
            LIVE PROJECT
          </a>
        )}
      </div>
    )}
  </section>

  <!-- Hero image -->
  {detail?.media[0] && (
    <figure class="mx-auto max-w-6xl px-6 pb-12">
      <div class="border-t-8 border-secondary">
        <Image
          src={detail.media[0].src}
          alt={detail.media[0].alt}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1152px) 100vw, 1152px"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="block w-full h-auto"
        />
      </div>

      <figcaption class="mt-3 font-mono text-lg text-primary">
        01 / {detail.media[0].alt}
      </figcaption>
    </figure>
  )}

  <!-- Project content -->
  <div class="mx-auto max-w-6xl px-6 pb-16">
    {detail?.sections.map((section, sectionIndex) => (
      <section
        class="grid gap-6 md:grid-cols-[240px_1fr] border-t-2 border-accent py-10"
      >
        <h2 class="font-mono text-3xl text-primary uppercase">
          // {String(sectionIndex + 1).padStart(2, "0")}{" "}{section.heading}
        </h2>

        <div class="project-content text-lg leading-8 text-foreground">
          {section.text
            .split(/\n\s*\n/)
            .filter(Boolean)
            .map((paragraph) => (
              <p>{paragraph.trim()}</p>
            ))}
        </div>
      </section>
    ))}

    <!-- Additional screenshots -->
    {detail && detail.media.length > 1 && (
      <section class="border-t-2 border-accent pt-10">
        <h2 class="font-mono text-3xl text-primary">
          // SCREENSHOTS
        </h2>

        <div class="mt-6 grid items-start gap-8 md:grid-cols-2">
          {detail.media.slice(1).map((media, mediaIndex) => (
            <figure>
              <Image
                src={media.src}
                alt={media.alt}
                widths={[400, 640, 960]}
                sizes="(min-width: 768px) 50vw, 100vw"
                format="webp"
                loading="lazy"
                decoding="async"
                class="w-full h-auto border-t-4 border-secondary"
              />

              <figcaption class="mt-3 font-mono text-lg text-primary">
                {String(mediaIndex + 2).padStart(2, "0")}{" "}
                / {media.alt}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Next project -->
    {next && (
      <nav
        aria-label="Next project"
        class="mt-12 border-t-2 border-primary pt-8"
      >
        <p class="font-mono text-xl text-primary">
          NEXT PROJECT
        </p>

        <a
          href={`/work/${next.slug}`}
          class="mt-3 flex items-center justify-between gap-4 text-2xl font-bold hover:text-primary transition-colors"
        >
          <span>{next.name}</span>
          <span aria-hidden="true" class="shrink-0">→</span>
        </a>
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .project-content p + p {
    margin-top: 1.25rem;
  }
</style>