
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag.astro";
import { projects } from "../../data/projects";

const siteUrl = "https://portfolio.ortheyus.uk";
const pageUrl = `${siteUrl}/work`;

const title = "Work | David Whalley — Ortheyus";

const description =
  "Explore personal projects, academic builds and experiments by David Whalley, including full-stack web applications, mobile apps and browser games.";

const image = `${siteUrl}/og/og-work.png`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: "en-GB",
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: image,
      },
      author: {
        "@id": `${siteUrl}/#person`,
      },
      mainEntity: {
        "@type": "ItemList",
        name: "Software development projects by David Whalley",
        numberOfItems: projects.length,
        itemListOrder: "https://schema.org/ItemListOrderDescending",
        itemListElement: projects.map((project, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: project.name,
          url: `${siteUrl}/work/${project.slug}`,
        })),
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  schema={schema}
>
  <!-- Page heading -->
  <div class="mx-auto max-w-6xl px-6 pt-16 pb-10">
    <p class="font-mono text-2xl text-secondary">
      // SELECT GAME
    </p>

    <h1 class="mt-2 font-display text-5xl md:text-7xl text-primary">
      Work
    </h1>

    <p class="mt-6 max-w-2xl text-lg text-muted-foreground">
      Personal projects, academic builds and experiments.
    </p>
  </div>

  <!-- Project listing -->
  <section
    class="mx-auto max-w-6xl px-6 pb-20"
    aria-label="Software development projects"
  >
    <div class="grid gap-4">
      {projects.map((project, index) => (
        <article
          class="group bg-card border-l-8 border-primary transition-colors hover:border-secondary"
        >
          <a
            href={`/work/${project.slug}`}
            class="grid gap-4 p-6 md:grid-cols-[80px_1fr_auto] focus-visible:outline-2 focus-visible:outline-primary"
            aria-label={`View ${project.name} project`}
          >
            <!-- Project number -->
            <span
              class="font-display text-3xl text-secondary"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>

            <!-- Project information -->
            <div>
              <h2
                class="text-xl font-bold transition-colors group-hover:text-primary"
              >
                {project.name}
              </h2>

              <p class="mt-1 text-muted-foreground">
                {project.description}
              </p>

              <div class="mt-3 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <Tag>{tag}</Tag>
                ))}
              </div>
            </div>

            <!-- Year and category -->
            <div class="font-mono text-xl text-primary md:text-right">
              {project.year}
              <br />
              <span class="text-muted-foreground uppercase">
                {project.category}
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>