
---
interface Props {
  kicker?: string;
  heading?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  kicker = "// PLAYER 2 — PRESS START",
  heading = "Got a project that needs shipping?",
  buttonText = "INSERT COIN →",
  buttonHref = "/contact",
} = Astro.props;
---

<section class="relative overflow-hidden">
  <!-- Decorative stripes -->
  <div
    aria-hidden="true"
    class="stripes h-24 -skew-y-3 origin-left"
  ></div>

  <div class="mx-auto max-w-6xl px-6 py-16 text-center">
    <p class="font-mono text-2xl text-primary">
      {kicker}
    </p>

    <h2 class="mt-3 text-4xl md:text-5xl font-bold">
      {heading}
    </h2>

    <a
      href={buttonHref}
      class="mt-8 inline-block bg-primary text-primary-foreground font-mono text-2xl px-8 py-3 shadow-[6px_6px_0_var(--secondary)] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition"
    >
      {buttonText}
    </a>
  </div>
</section>