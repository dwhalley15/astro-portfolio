
---
import Tag from "./Tag.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

const number = String(index + 1).padStart(2, "0");
---

<article
  class="group bg-card border-t-8 border-secondary transition-colors hover:border-primary"
>
  <a
    href={`/work/${project.slug}`}
    class="flex h-full flex-col gap-3 p-6 focus-visible:outline-2 focus-visible:outline-primary"
    aria-label={`View ${project.name} project`}
  >
    <div class="flex items-center justify-between font-mono text-xl text-primary">
      <span>{number} · {project.year}</span>
      <span
        aria-hidden="true"
        class="transition-transform group-hover:translate-x-1"
      >
        →
      </span>
    </div>

    <h3 class="text-xl font-bold transition-colors group-hover:text-primary">
      {project.name}
    </h3>

    <p class="flex-1 text-muted-foreground">
      {project.description}
    </p>

    <div class="flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <Tag>{tag}</Tag>
      ))}
    </div>
  </a>
</article>