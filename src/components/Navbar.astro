---
interface NavItem {
  path: string;
  label: string;
}

const navigationItems: NavItem[] = [
  { path: "/", label: "Home" },
  { path: "/work", label: "Work" },
  { path: "/about", label: "About" },
  { path: "/notes", label: "Notes" },
  { path: "/uses", label: "Uses" },
  { path: "/contact", label: "Contact" },
];

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (path: string) =>
  pathname === (path.replace(/\/+$/, "") || "/");
---

<header class="relative z-50 border-b-4 border-primary">
  <nav
    class="mx-auto max-w-6xl px-6 py-5"
    aria-label="Main navigation"
  >
    <div class="flex items-center justify-between gap-4">
      <!-- Logo -->
      <a
        href="/"
        class="font-display text-2xl text-primary"
        aria-label="Ortheyus - Home"
      >
        ORTHEYUS
      </a>

      <!-- Desktop navigation -->
      <ul class="hidden items-center gap-1 font-mono text-xl md:flex">
        {navigationItems.map((item) => (
          <li>
            <a
              href={item.path}
              aria-current={isActive(item.path) ? "page" : undefined}
              class:list={[
                "px-3 py-1 uppercase transition-colors hover:text-primary",
                isActive(item.path)
                  ? "bg-primary text-primary-foreground"
                  : "",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile navigation -->
      <details class="mobile-menu relative md:hidden">
        <summary
          class="flex min-h-11 cursor-pointer list-none items-center gap-3 border-2 border-primary px-3 py-2 font-mono text-xl text-primary select-none transition-colors duration-200 hover:bg-primary hover:text-background"
          aria-label="Toggle navigation menu"
        >
          <span class="menu-label">MENU</span>

          <span class="menu-icon" aria-hidden="true">
            <span class="menu-line menu-line-top"></span>
            <span class="menu-line menu-line-middle"></span>
            <span class="menu-line menu-line-bottom"></span>
          </span>
        </summary>

        <!-- Dropdown -->
        <div
          class="mobile-dropdown absolute top-full right-0 z-50 mt-3 w-56 border-2 border-primary bg-background p-2 shadow-[6px_6px_0_var(--secondary)]"
        >
          <ul class="flex flex-col gap-1 font-mono text-2xl">
            {navigationItems.map((item) => (
              <li>
                <a
                  href={item.path}
                  aria-current={isActive(item.path) ? "page" : undefined}
                  class:list={[
                    "block px-4 py-3 uppercase transition-colors hover:bg-primary hover:text-background",
                    isActive(item.path)
                      ? "bg-primary text-primary-foreground"
                      : "text-foreground",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  /* Remove default details marker */
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary::marker {
    content: "";
  }

  /* Hamburger container */
  .menu-icon {
    position: relative;
    display: block;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  /* Hamburger lines */
  .menu-line {
    position: absolute;
    left: 3px;
    width: 18px;
    height: 2.5px;
    background: currentColor;
    transform-origin: center;
    transition:
      top 250ms ease,
      transform 250ms ease,
      opacity 150ms ease;
  }

  .menu-line-top {
    top: 5px;
  }

  .menu-line-middle {
    top: 11px;
  }

  .menu-line-bottom {
    top: 17px;
  }

  /* Animate hamburger into X */
  .mobile-menu[open] .menu-line-top {
    top: 11px;
    transform: rotate(45deg);
  }

  .mobile-menu[open] .menu-line-middle {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-menu[open] .menu-line-bottom {
    top: 11px;
    transform: rotate(-45deg);
  }

  /* Keep MENU label visible to avoid button resizing */
  .menu-label {
    transition: color 200ms ease;
  }

  /* Dropdown entrance */
  .mobile-menu[open] .mobile-dropdown {
    animation: dropdown-enter 220ms ease-out both;
  }

  @keyframes dropdown-enter {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Respect reduced-motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .menu-line,
    .menu-label {
      transition: none;
    }

    .mobile-menu[open] .mobile-dropdown {
      animation: none;
    }
  }
</style>